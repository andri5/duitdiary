# Maintenance mode (sama konsep VITE_MAINTENANCE_MODE di web)
# EXPO_PUBLIC_MAINTENANCE_MODE=true

# Device fisik / Expo Go: ganti dengan IP LAN PC kamu (satu Wi-Fi dengan HP)
EXPO_PUBLIC_API_URL=http://10.44.28.114:3001/api/v1

# Emulator Android → host machine
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# iOS Simulator
# EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# EAS APK (preview): set di eas.json → build.preview.env.EXPO_PUBLIC_API_URL
# Production: wajib HTTPS, contoh https://api.domainmu.com/api/v1
